# Apollo HealthLine Environment Variables

# API URL for Next.js frontend (default: local development)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Bolna API Configuration (for FastAPI backend in apps/api)
BOLNA_API_KEY=your_bolna_api_key_here
BOLNA_AGENT_ID=your_agent_id_here
BOLNA_API_URL=https://api.bolna.dev

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./appointments.db